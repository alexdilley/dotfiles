[user]
	name = Alex Dilley
	email = alex.dilley@gmail.com
[alias]
	br = branch
	co = checkout
	lol = log --pretty=oneline --abbrev-commit --graph --decorate
	st = status -s
[branch]
	autoSetupMerge = simple
	autoSetupRebase = always
[color]
	ui = true
[core]
	editor = /opt/homebrew/bin/nvim
	pager = /opt/homebrew/share/git-core/contrib/diff-highlight/diff-highlight | less -x4
[fetch]
	prune = true
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[init]
	defaultBranch = trunk
